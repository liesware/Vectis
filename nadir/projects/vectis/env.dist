# Nadir environment for the Vectis project integration.
# Nadir loads this file automatically for commands that use project.py.
# Keep committed values synthetic or blank. Exported NADIR_* values override it,
# which permits local credentials without storing them in Git.

# Required for every Vectis target.
NADIR_BASE_URL=http://127.0.0.1:3000
NADIR_KID=

# Required for vectis.sign-verification and runs that execute all targets.
# This value is redacted from Nadir artifacts and never accepted as a CLI flag.
NADIR_API_KEY=
NADIR_DENIED_API_KEY=
NADIR_SCOPED_API_KEY=

# Any other NADIR_* becomes a {lowercased} template variable inside targets.yaml,
# so target specs reference values instead of hardcoding them. The control digest
# for vectis.sign-verification is sha256("nadir-sign-verification-control-v1").
NADIR_DIGEST=04c30d8f8906cd86b98b83496d8c7a46a27ab897b8d7a116906b0bf674cbcdc5

# Profiles and synthetic control values used by local targets. The isolated
# harness creates the exact signed profiles, KID permissions, and message access.
NADIR_FPE_PROFILE=nadir-fpe-v1
NADIR_FPE_REF=nadir-fpe-control
NADIR_FPE_PLAINTEXT=1234567890
NADIR_FPE_BATCH_REF_ZERO=nadir-fpe-batch-zero
NADIR_FPE_BATCH_REF_ONE=nadir-fpe-batch-one
NADIR_FPE_BATCH_PLAINTEXT_ZERO=1234567890
NADIR_FPE_BATCH_PLAINTEXT_ONE=0987654321
NADIR_MAC_PROFILE=nadir-mac-v1
NADIR_MAC_REF=nadir-mac-control
NADIR_MAC_PLAINTEXT=nadir-mac-sample-value
NADIR_MAC_BATCH_REF_ZERO=nadir-mac-batch-zero
NADIR_MAC_BATCH_REF_ONE=nadir-mac-batch-one
NADIR_MAC_BATCH_PLAINTEXT_ZERO=nadir-mac-batch-primary
NADIR_MAC_BATCH_PLAINTEXT_ONE=nadir-mac-batch-secondary
NADIR_MAC_BATCH_MUTATED_PLAINTEXT=nadir-mac-batch-mutated
# Blind indexes reuse NADIR_MAC_PROFILE. These are synthetic values declared as
# redacted so response checks and finding artifacts never retain their plaintext.
NADIR_INDEX_PROFILE=nadir-mac-v1
NADIR_INDEX_REF=nadir-index-control
NADIR_INDEX_PLAINTEXT=nadir-index-primary-value
NADIR_INDEX_MUTATED_PLAINTEXT=nadir-index-secondary-value
NADIR_INDEX_VERIFY_REF=nadir-index-verify
NADIR_INDEX_VERIFY_PLAINTEXT=nadir-index-absent-value
NADIR_INDEX_BATCH_REF_ZERO=nadir-index-batch-zero
NADIR_INDEX_BATCH_REF_ONE=nadir-index-batch-one
NADIR_INDEX_BATCH_PLAINTEXT_ZERO=nadir-index-batch-primary
NADIR_INDEX_BATCH_PLAINTEXT_ONE=nadir-index-batch-secondary
NADIR_INDEX_ATOMIC_REF_ZERO=nadir-index-atomic-zero
NADIR_INDEX_ATOMIC_REF_ONE=nadir-index-atomic-one
NADIR_INDEX_ATOMIC_PLAINTEXT_ZERO=nadir-index-atomic-primary
NADIR_INDEX_ATOMIC_PLAINTEXT_ONE=nadir-index-atomic-secondary
# Commitments are stateless, but their random openings are artifact-only
# secrets. Plaintexts remain response/artifact redactions like other inputs.
NADIR_COMMIT_PROFILE=nadir-commitment-v1
NADIR_COMMIT_OPENING_LEN=32
NADIR_COMMIT_REF=nadir-commit-control
NADIR_COMMIT_RANDOM_REF=nadir-commit-random
NADIR_COMMIT_PLAINTEXT=nadir-commit-primary-value
NADIR_COMMIT_MUTATED_PLAINTEXT=nadir-commit-secondary-value
NADIR_COMMIT_BATCH_REF_ZERO=nadir-commit-batch-zero
NADIR_COMMIT_BATCH_REF_ONE=nadir-commit-batch-one
NADIR_COMMIT_BATCH_PLAINTEXT_ZERO=nadir-commit-batch-primary
NADIR_COMMIT_BATCH_PLAINTEXT_ONE=nadir-commit-batch-secondary
# Shares are sensitive artifact material. Nadir captures all five values from a
# fresh split, while the local harness supplies these only for retired recovery.
NADIR_SHARE_PROFILE=nadir-sharing-3of5-v1
NADIR_SHARE_THRESHOLD=3
NADIR_SHARE_TOTAL=5
NADIR_SHARE_PLAINTEXT=nadir-sharing-primary-secret
NADIR_RETIRED_SHARE_PROFILE=nadir-retired-sharing-3of5-v1
NADIR_RETIRED_SHARE_PLAINTEXT=nadir-sharing-retired-secret
NADIR_RETIRED_SHARE_ZERO=
NADIR_RETIRED_SHARE_ONE=
NADIR_RETIRED_SHARE_TWO=
NADIR_RETIRED_SHARE_SET_ID=
# Synthetic stand-in for a maskable value: 16 chars ending 1111, but not a valid
# PAN (contains letters, fails Luhn) so secret/PAN scanners never flag it.
NADIR_MASK_PROFILE=nadir-mask-v1
NADIR_MASK_REF=nadir-mask-control
NADIR_MASK_PLAINTEXT=nadir-pan-001111
NADIR_MASK_EXPECTED=************1111
NADIR_MASK_POLICY_REF=nadir-mask-policy
NADIR_MASK_POLICY_PLAINTEXT=nadir-pan-001111
NADIR_MASK_VISIBLE_FIRST=0
NADIR_MASK_VISIBLE_LAST=4
NADIR_MASK_CHAR=*
NADIR_MASK_BATCH_REF_ZERO=nadir-mask-batch-zero
NADIR_MASK_BATCH_REF_ONE=nadir-mask-batch-one
NADIR_MASK_BATCH_PLAINTEXT_ZERO=nadir-mask-001111
NADIR_MASK_BATCH_PLAINTEXT_ONE=nadir-mask-002222
NADIR_TOKEN_PROFILE=nadir-token-v1
NADIR_TOKEN_TOKEN_PREFIX=nadir_tok
NADIR_TOKEN_REF=nadir-token-control
NADIR_TOKEN_PLAINTEXT=nadir-token-plaintext
NADIR_TOKEN_METADATA_TENANT=nadir
NADIR_TOKEN_BATCH_REF_ZERO=nadir-token-batch-zero
NADIR_TOKEN_BATCH_REF_ONE=nadir-token-batch-one
NADIR_TOKEN_BATCH_PLAINTEXT_ZERO=nadir-token-batch-primary
NADIR_TOKEN_BATCH_PLAINTEXT_ONE=nadir-token-batch-secondary
NADIR_TOKEN_BATCH_METADATA_ZERO=nadir-batch-zero
NADIR_TOKEN_BATCH_METADATA_ONE=nadir-batch-one
NADIR_TOKEN_ONCE_PROFILE=nadir-once-v1
NADIR_TOKEN_ONCE_TOKEN_PREFIX=nadir_once
NADIR_TOKEN_ONCE_REF=nadir-once-control
NADIR_TOKEN_ONCE_PLAINTEXT=nadir-once-plaintext
NADIR_TOKEN_ONCE_METADATA_TENANT=nadir-once
NADIR_TOKEN_ONCE_BATCH_REF_ZERO=nadir-once-batch-zero
NADIR_TOKEN_ONCE_BATCH_REF_ONE=nadir-once-batch-one
NADIR_INTERNAL_MESSAGE_PLAINTEXT=nadir-internal-message-control

# A second KID is prepared active, used once, and retired by tests/security/nadir/run.sh.
# It proves that historical decrypt works while new encryption is blocked.
NADIR_RETIRED_KID=
NADIR_RETIRED_FPE_PROFILE=nadir-retired-fpe-v1
NADIR_RETIRED_FPE_REF=nadir-retired-fpe-control
NADIR_RETIRED_FPE_PLAINTEXT=1234567890
NADIR_RETIRED_FPE_CIPHERTEXT=
